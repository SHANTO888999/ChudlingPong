rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all unspecified paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidGuestId(id) {
      return id is string && id.size() >= 22 && id.size() <= 40 && id.matches('^guest_[a-zA-Z0-9]{16,32}$');
    }

    function isValidGoogleId(id) {
      return isValidId(id) && !id.matches('^guest_.*');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid',
          'playerName',
          'score',
          'fireMode',
          'zappedCount',
          'bestCombo',
          'isGuest',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'playerName',
          'score',
          'fireMode',
          'zappedCount',
          'bestCombo',
          'isGuest',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 24
        && data.playerName.matches('^[a-zA-Z0-9 _\\-\\.]{1,24}$')
        && data.score is int
        && data.score >= 0
        && data.score <= 100000
        && data.fireMode is string
        && data.fireMode in ['hand', 'thirdLeg']
        && data.zappedCount is int
        && data.zappedCount >= 0
        && data.zappedCount <= 100000
        && data.bestCombo is int
        && data.bestCombo >= 0
        && data.bestCombo <= 10000
        && data.isGuest is bool
        && data.updatedAt is timestamp;
    }

    // Public PII-free arcade leaderboard (optional Google login + unique guest IDs)
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if resource.data.score >= 0
        && request.query.limit != null
        && request.query.limit <= 50;

      allow create: if isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == entryId
        && incoming().updatedAt == request.time
        && (
          (
            isEmailVerified()
            && isValidGoogleId(entryId)
            && request.auth.uid == entryId
            && incoming().isGuest == false
          )
          ||
          (
            isValidGuestId(entryId)
            && incoming().isGuest == true
          )
        );

      allow update: if isValidId(entryId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          (
            isEmailVerified()
            && isValidGoogleId(entryId)
            && request.auth.uid == entryId
            && incoming().isGuest == false
            && (!('isGuest' in existing()) || existing().isGuest == false)
          )
          ||
          (
            isValidGuestId(entryId)
            && incoming().isGuest == true
            && existing().isGuest == true
          )
        )
        && (
          incoming().score >= existing().score
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'playerName',
            'score',
            'fireMode',
            'zappedCount',
            'bestCombo',
            'isGuest',
            'updatedAt'
          ])
        );

      allow delete: if isEmailVerified()
        && isValidGoogleId(entryId)
        && request.auth.uid == entryId;
    }
  }
}
